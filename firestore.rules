rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Bimbel Core State and Sync Collections
    match /bimbel_state/{docId} {
      allow read, write: if true;
    }
    match /chats/{chatId} {
      allow read, write: if true;
    }
    match /students/{studentId} {
      allow read, write: if true;
    }
    match /attendance/{attId} {
      allow read, write: if true;
    }
    match /assessments/{assId} {
      allow read, write: if true;
    }
    match /activities/{actId} {
      allow read, write: if true;
    }
    match /invoices/{invId} {
      allow read, write: if true;
    }
    match /broadcasts/{bcId} {
      allow read, write: if true;
    }
    match /teacherAttendance/{tattId} {
      allow read, write: if true;
    }
    match /locations/{locId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
